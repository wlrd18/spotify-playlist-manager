SPOTIFY_CLIENT_ID=
SPOTIFY_REDIRECT_URI=http://127.0.0.1:8000/api/auth/spotify/callback
DATABASE_URL=postgresql://postgres:YOUR_DATABASE_PASSWORD@YOUR_SUPABASE_HOST:5432/postgres?sslmode=require
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=
CACHE_RETENTION_HOURS=24
SYNC_CONCURRENCY=3
SPOTIFY_MAX_RETRIES=5
NEAR_DUPLICATE_JACCARD=0.80
STRONG_OVERLAP_JACCARD=0.55
MIN_TRACKS_FOR_SCORE=8
